# DeepSeek API token (required for production)
DEEPSEEK_API_TOKEN=your-api-key-here

# Provider configuration
PROVIDER_TYPE=deepseek
PROVIDER_BASE_URL=https://api.deepseek.com/anthropic/v1
PROVIDER_MODEL=deepseek-v4-pro
PROVIDER_REQUEST_TIMEOUT=120
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BACKOFF=1.0

# Database path (SQLite for local dev)
PERSISTENCE_DB_PATH=data/agent.db
HITL_EXPIRY_MINUTES=30
IDEMPOTENCY_RETENTION_DAYS=90

# Agent limits
MAX_AGENT_STEPS=50

# Live test flag (opt-in)
LIVE_PROVIDER_TEST=0
